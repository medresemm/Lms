# Shared database
DATABASE_URL=postgresql://user:password@host:5432/database

# API runtime
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SYSTEM_OWNER_EMAIL=
SYSTEM_OWNER_NAME=
ADMIN_USER_IDS=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# File storage (Supabase Storage, S3-compatible connection)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=

# Frontend build/runtime values
BASE_PATH=/medine-lms
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
VITE_SYSTEM_OWNER_EMAIL=
VITE_SYSTEM_OWNER_NAME=

# Optional regression test configuration
REGRESSION_BASE_URL=http://localhost:8080
REGRESSION_AUTHORIZATION=
REGRESSION_OWNER_AUTHORIZATION=
REGRESSION_TEACHER_AUTHORIZATION=
REGRESSION_STUDENT_AUTHORIZATION=