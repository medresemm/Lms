{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "build:vercel": "node ./build.vercel.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:application-window": "tsx --test src/lib/applicationWindow.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ai": "tsx --test src/lib/ai/internalProvider.test.ts",
    "test:certificate": "tsx --test src/lib/certificateBidi.test.ts",
    "test:lesson-attendance": "tsx --test src/lib/lessonAttendance.test.ts",
    "test:research": "tsx --test src/lib/ai/research.test.ts",
    "test:ai-modes": "tsx --test src/lib/ai/adminRouting.test.ts",
    "test:ai-student-external": "tsx --test src/lib/ai/studentExternal.test.ts",
    "test:library": "tsx --test src/lib/library/library.test.ts src/lib/library/missingTable.test.ts src/lib/library/courseBooks.test.ts src/lib/library/resourceBooks.test.ts ../medine-lms/src/lib/resource-books.test.ts",
    "test:ai-polish": "tsx --test src/lib/ai/aiPolish.test.ts ../medine-lms/src/lib/aiPolish.test.ts",
    "test:exams": "tsx --test src/lib/examContent.test.ts ../medine-lms/src/lib/exam-text.test.ts",
    "test:account-profile": "tsx --test src/lib/accountProfile.test.ts ../medine-lms/src/lib/account-profile-retry.test.ts",
    "test:schedule-pdf": "tsx --test src/lib/schedulePdf.test.ts",
    "test:test-builder": "tsx --test src/lib/library/testGenerator.test.ts",
    "test:co-teachers": "tsx --test src/lib/resourceTeachers.test.ts ../medine-lms/src/lib/co-teachers.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@clerk/express": "^2.1.61",
    "@clerk/shared": "^4.29.3",
    "@swc/helpers": "^0.5.23",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pdfkit": "^0.20.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "tsx": "catalog:",
    "thread-stream": "3.1.0"
  }
}
